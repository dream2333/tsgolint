From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TSGolint experiment <tsgolint-experiment@localhost>
Date: Thu, 24 Sep 2026 11:18:06 +0100
Subject: [PATCH 6/6] perf: add opt-in node-count checker assignment

---
 tsc/internal/compiler/checkerpool.go | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/tsc/internal/compiler/checkerpool.go b/tsc/internal/compiler/checkerpool.go
index 00a0ce4360..9a0179b4b9 100644
--- a/tsc/internal/compiler/checkerpool.go
+++ b/tsc/internal/compiler/checkerpool.go
@@ -1,8 +1,10 @@
 package compiler
 
 import (
+	"cmp"
 	"context"
 	"math"
+	"os"
 	"slices"
 	"sort"
 	"sync"
@@ -380,6 +382,18 @@ func (p *checkerPool) createCheckers() {
 
 		wg.RunAndWait()
 
+		p.fileAssociations = make(map[*ast.SourceFile]*checker.Checker, len(p.program.files))
+		if checkerCount > 1 && os.Getenv("OXLINT_TSGOLINT_CHECKER_SCHEDULING") == "sorted" {
+			files := slices.Clone(p.program.files)
+			slices.SortStableFunc(files, func(a, b *ast.SourceFile) int {
+				return cmp.Compare(b.NodeCount, a.NodeCount)
+			})
+			for i, file := range files {
+				p.fileAssociations[file] = p.checkers[i%checkerCount]
+			}
+			return
+		}
+
 		associations := make([]int, len(p.program.files))
 		if checkerCount > 1 {
 			baseWeights := make([]int, len(p.program.files))
@@ -412,7 +426,6 @@ func (p *checkerPool) createCheckers() {
 			fileOrder := getCheckerAssociationOrder(fileWeights, isDeclarationFile, policy.prioritizeSourceFiles)
 			associations = getCheckerAssociationsInOrder(fileWeights, adjacentFiles, fileOrder, checkerCount, policy.balancePenaltyMultiplier)
 		}
-		p.fileAssociations = make(map[*ast.SourceFile]*checker.Checker, len(p.program.files))
 		for i, file := range p.program.files {
 			p.fileAssociations[file] = p.checkers[associations[i]]
 		}
